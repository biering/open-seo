# OpenSEO Cloudflare self-host. Walkthrough: docs/SELF_HOSTING_CLOUDFLARE_ALCHEMY.md

# ---------- Required ----------

# Get one at https://dataforseo.com — see docs/DATAFORSEO_API_KEY.md
DATAFORSEO_API_KEY=

# Who may sign in through Cloudflare Access, comma-separated
ACCESS_ALLOWED_EMAILS=

# ---------- Optional — uncomment to use ----------

# Google Search Console (all three together) — docs/SELF_HOSTING_GOOGLE_SEARCH_CONSOLE.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_SECRET=

# SAM, the in-app agent (hidden if unset)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Optional: Context.dev fallback for the site audit "Render JavaScript" option.
# Cloudflare Browser Run renders first; Context renders the pages it cannot
# (a paid Workers plan is required) — docs/SELF_HOSTING_CLOUDFLARE_OPERATIONS.md
# CONTEXT_API_KEY=

# Your own PostHog product analytics
# POSTHOG_PUBLIC_KEY=
# POSTHOG_HOST=

# Serve OpenSEO on your own hostname instead of only the workers.dev URL. The
# zone must already be in this Cloudflare account; the DNS record and the
# Access application covering it are created for you. The workers.dev URL
# keeps working. Add it here, not in the dashboard — the deploy reconciles the
# Worker's custom domains and detaches any it does not know about.
# CUSTOM_DOMAIN=seo.example.com

# Let an MCP agent in without a browser login. Create a service token in Zero
# Trust (Access controls -> Service credentials), put its ID (the UUID, not
# the Client ID) here, and have the agent send the CF-Access-Client-Id and
# CF-Access-Client-Secret headers. Comma-separate several tokens.
# ACCESS_SERVICE_TOKEN_IDS=

# Opt out of anonymized telemetry — docs/SELF_HOSTING_CLOUDFLARE_OPERATIONS.md
# OPENSEO_TELEMETRY_DISABLED=1

# Bring your own Cloudflare Access application instead of the auto-provisioned
# one (ACCESS_ALLOWED_EMAILS is then ignored)
# TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# POLICY_AUD=your-access-application-audience-tag

# Running several deployments from one checkout — `pnpm deploy:selfhost NAME`
# deploys from `.env.NAME` instead of this file. Each instance needs its own
# Cloudflare account or its own stage (the stage names every resource and
# defaults to NAME). To deploy with an API token instead of `alchemy login`,
# point ALCHEMY_PROFILE at a profile configured to read credentials from the
# environment and set both CLOUDFLARE_ variables.
# DEPLOY_STAGE=
# ALCHEMY_PROFILE=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
